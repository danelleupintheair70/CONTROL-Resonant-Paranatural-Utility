{
  "catalogue": "templates/1",
  "templates": [
    {"id": "voice/preserve", "kind": "voice", "family": "preserve", "title": "Preserve",
     "purpose": "Leave the take's own emphasis exactly as generated. Always a candidate.",
     "tags": ["neutral"]},
    {"id": "voice/steady", "kind": "voice", "family": "flatten", "title": "Steady",
     "purpose": "Even out a take whose loudness wanders without dramatic reason.",
     "params": {"amount": {"default": 0.4, "min": 0.0, "max": 0.8, "units": "share"},
                "strength": {"default": 1.0, "min": 0.0, "max": 1.0, "units": "share"}},
     "contraindications": ["intentional_cutoff", "shout"], "tags": ["calm", "narration"]},
    {"id": "voice/early-emphasis", "kind": "voice", "family": "curve", "title": "Early emphasis",
     "purpose": "The weight lands on the first words, then settles.",
     "anchors": [{"at": 0.0, "db": 2.5}, {"at": 0.3, "db": 1.5}, {"at": 0.6, "db": 0.0},
                 {"at": 1.0, "db": -1.0}],
     "params": {"strength": {"default": 1.0, "min": 0.0, "max": 1.5, "units": "share"}},
     "valid_duration": {"min": 0.8, "max": 20.0}, "tags": ["command", "call", "urgent"]},
    {"id": "voice/middle-emphasis", "kind": "voice", "family": "curve", "title": "Middle emphasis",
     "purpose": "The key word sits in the middle of the line.",
     "anchors": [{"at": 0.0, "db": -1.0}, {"at": 0.5, "db": 2.5}, {"at": 1.0, "db": -1.0}],
     "params": {"strength": {"default": 1.0, "min": 0.0, "max": 1.5, "units": "share"}},
     "valid_duration": {"min": 1.0, "max": 20.0}, "tags": ["explain"]},
    {"id": "voice/late-emphasis", "kind": "voice", "family": "curve", "title": "Late emphasis",
     "purpose": "The line builds to its last words.",
     "anchors": [{"at": 0.0, "db": -1.0}, {"at": 0.5, "db": 0.0}, {"at": 0.8, "db": 2.0},
                 {"at": 1.0, "db": 2.5}],
     "params": {"strength": {"default": 1.0, "min": 0.0, "max": 1.5, "units": "share"}},
     "valid_duration": {"min": 0.8, "max": 20.0},
     "contraindications": ["intentional_cutoff", "trailing"], "tags": ["reveal", "punchline"]},
    {"id": "voice/gradual-rise", "kind": "voice", "family": "curve", "title": "Gradual rise",
     "purpose": "Growing intensity across the line.",
     "anchors": [{"at": 0.0, "db": -2.5}, {"at": 1.0, "db": 2.5}],
     "params": {"strength": {"default": 1.0, "min": 0.0, "max": 1.5, "units": "share"}},
     "valid_duration": {"min": 1.2, "max": 20.0}, "contraindications": ["trailing"],
     "tags": ["anger", "excited"]},
    {"id": "voice/gradual-fall", "kind": "voice", "family": "curve", "title": "Gradual fall",
     "purpose": "Energy drains away as the line goes on.",
     "anchors": [{"at": 0.0, "db": 1.5}, {"at": 1.0, "db": -3.0}],
     "params": {"strength": {"default": 1.0, "min": 0.0, "max": 1.5, "units": "share"}},
     "valid_duration": {"min": 1.2, "max": 20.0}, "tags": ["sad", "weary"]},
    {"id": "voice/rise-and-release", "kind": "voice", "family": "curve",
     "title": "Rise and release",
     "purpose": "Builds to a peak two thirds in, then lets go.",
     "anchors": [{"at": 0.0, "db": -1.5}, {"at": 0.65, "db": 2.5}, {"at": 1.0, "db": -1.5}],
     "params": {"strength": {"default": 1.0, "min": 0.0, "max": 1.5, "units": "share"}},
     "valid_duration": {"min": 1.5, "max": 20.0}, "tags": ["argument"]},
    {"id": "voice/repeated-peaks", "kind": "voice", "family": "peak_linked",
     "title": "Repeated peaks",
     "purpose": "Lift each stressed word the take already has, a little.",
     "params": {"bump_db": {"default": 2.0, "min": 0.0, "max": 4.0, "units": "dB"},
                "width_ms": {"default": 180, "min": 80, "max": 400, "units": "ms"},
                "max_peaks": {"default": 4, "min": 1, "max": 8, "units": "count"},
                "anchor": {"default": 0, "min": 0, "max": 0, "units": "0=peaks"},
                "strength": {"default": 1.0, "min": 0.0, "max": 1.5, "units": "share"}},
     "valid_duration": {"min": 1.0, "max": 30.0}, "min_evidence": {"active_seconds": 0.6},
     "tags": ["insistent", "list"]},
    {"id": "voice/phrase-linked-peaks", "kind": "voice", "family": "peak_linked",
     "title": "Phrase-linked peaks",
     "purpose": "A lift at the start of each phrase, following the take's own pauses.",
     "params": {"bump_db": {"default": 1.5, "min": 0.0, "max": 4.0, "units": "dB"},
                "width_ms": {"default": 260, "min": 80, "max": 500, "units": "ms"},
                "max_peaks": {"default": 4, "min": 1, "max": 8, "units": "count"},
                "anchor": {"default": 1, "min": 1, "max": 1, "units": "1=phrase starts"},
                "strength": {"default": 1.0, "min": 0.0, "max": 1.5, "units": "share"}},
     "valid_duration": {"min": 1.5, "max": 30.0}, "min_evidence": {"active_seconds": 0.8},
     "tags": ["phrased"]},
    {"id": "voice/trailing-finish", "kind": "voice", "family": "curve", "title": "Trailing finish",
     "purpose": "The last words fall away, as a thought left unfinished.",
     "anchors": [{"at": 0.0, "db": 0.0}, {"at": 0.7, "db": 0.0}, {"at": 1.0, "db": -6.0}],
     "params": {"strength": {"default": 1.0, "min": 0.0, "max": 1.5, "units": "share"}},
     "valid_duration": {"min": 0.8, "max": 20.0}, "contraindications": ["shout"],
     "tags": ["trailing", "hesitant"]},
    {"id": "voice/intentional-cutoff", "kind": "voice", "family": "curve",
     "title": "Intentional cutoff",
     "purpose": "Full voice to the end, then cut short (someone breaks in).",
     "anchors": [{"at": 0.0, "db": 0.0}, {"at": 0.92, "db": 0.0}, {"at": 1.0, "db": -12.0}],
     "interpolation": "linear", "smoothing_ms": 10,
     "params": {"strength": {"default": 1.0, "min": 0.0, "max": 1.0, "units": "share"}},
     "valid_duration": {"min": 0.5, "max": 20.0}, "tags": ["intentional_cutoff", "interrupted"]},
    {"id": "voice/sustained-emphasis", "kind": "voice", "family": "curve",
     "title": "Sustained emphasis",
     "purpose": "Held intensity across the whole line, with soft edges.",
     "anchors": [{"at": 0.0, "db": 0.0}, {"at": 0.12, "db": 2.0}, {"at": 0.88, "db": 2.0},
                 {"at": 1.0, "db": 0.0}],
     "params": {"strength": {"default": 1.0, "min": 0.0, "max": 1.5, "units": "share"}},
     "valid_duration": {"min": 1.0, "max": 30.0}, "contraindications": ["whisper"],
     "tags": ["shout", "call"]},
    {"id": "background/preserve", "kind": "background", "family": "bed_legacy",
     "title": "Current ducking",
     "purpose": "The existing sidechain ducking, exactly as before."},
    {"id": "background/steady-trim", "kind": "background", "family": "bed",
     "title": "Steady trim",
     "purpose": "A constant trim of the bed, no ducking (quiet beds, sparse dialogue).",
     "params": {"trim_db": {"default": -2.0, "min": -9.0, "max": 0.0, "units": "dB"},
                "duck_db": {"default": 0.0, "min": 0.0, "max": 0.0, "units": "dB"},
                "attack_ms": {"default": 100, "min": 100, "max": 100, "units": "ms"},
                "release_ms": {"default": 400, "min": 400, "max": 400, "units": "ms"}}},
    {"id": "background/gentle-ducking", "kind": "background", "family": "bed",
     "title": "Gentle ducking",
     "purpose": "The bed steps back a little under speech and comes back smoothly.",
     "params": {"trim_db": {"default": 0.0, "min": -6.0, "max": 0.0, "units": "dB"},
                "duck_db": {"default": -4.0, "min": -8.0, "max": 0.0, "units": "dB"},
                "attack_ms": {"default": 120, "min": 40, "max": 400, "units": "ms"},
                "release_ms": {"default": 450, "min": 150, "max": 1500, "units": "ms"},
                "hold_ms": {"default": 250, "min": 0, "max": 1000, "units": "ms"}}},
    {"id": "background/strong-ducking", "kind": "background", "family": "bed",
     "title": "Strong ducking",
     "purpose": "Loud music under dialogue: the bed makes clear room for speech.",
     "params": {"trim_db": {"default": 0.0, "min": -6.0, "max": 0.0, "units": "dB"},
                "duck_db": {"default": -10.0, "min": -15.0, "max": -4.0, "units": "dB"},
                "attack_ms": {"default": 60, "min": 20, "max": 300, "units": "ms"},
                "release_ms": {"default": 300, "min": 150, "max": 1200, "units": "ms"},
                "hold_ms": {"default": 200, "min": 0, "max": 1000, "units": "ms"}}},
    {"id": "background/pause-aware-recovery", "kind": "background", "family": "bed",
     "title": "Pause-aware recovery",
     "purpose": "Stays down through short hesitations; recovers only in real pauses.",
     "params": {"trim_db": {"default": 0.0, "min": -6.0, "max": 0.0, "units": "dB"},
                "duck_db": {"default": -6.0, "min": -12.0, "max": 0.0, "units": "dB"},
                "attack_ms": {"default": 100, "min": 40, "max": 400, "units": "ms"},
                "release_ms": {"default": 600, "min": 200, "max": 2000, "units": "ms"},
                "hold_ms": {"default": 300, "min": 0, "max": 1500, "units": "ms"},
                "gap_recover_s": {"default": 0.9, "min": 0.2, "max": 3.0, "units": "s"}}},
    {"id": "background/post-dialogue-swell", "kind": "background", "family": "bed",
     "title": "Post-dialogue swell",
     "purpose": "After a scene's last line the bed rises a little before settling.",
     "params": {"trim_db": {"default": 0.0, "min": -6.0, "max": 0.0, "units": "dB"},
                "duck_db": {"default": -6.0, "min": -12.0, "max": 0.0, "units": "dB"},
                "attack_ms": {"default": 100, "min": 40, "max": 400, "units": "ms"},
                "release_ms": {"default": 800, "min": 200, "max": 2000, "units": "ms"},
                "hold_ms": {"default": 250, "min": 0, "max": 1000, "units": "ms"},
                "swell_db": {"default": 2.0, "min": 0.0, "max": 3.0, "units": "dB"},
                "swell_s": {"default": 1.5, "min": 0.5, "max": 4.0, "units": "s"}}},
    {"id": "background/transient-protection", "kind": "background", "family": "bed",
     "title": "Transient protection",
     "purpose": "Ducks under speech but never buries an impact or a sting in the bed.",
     "params": {"trim_db": {"default": 0.0, "min": -6.0, "max": 0.0, "units": "dB"},
                "duck_db": {"default": -6.0, "min": -12.0, "max": 0.0, "units": "dB"},
                "attack_ms": {"default": 80, "min": 20, "max": 300, "units": "ms"},
                "release_ms": {"default": 400, "min": 150, "max": 1500, "units": "ms"},
                "hold_ms": {"default": 200, "min": 0, "max": 1000, "units": "ms"},
                "transient_db": {"default": 8.0, "min": 4.0, "max": 15.0, "units": "dB"}}},
    {"id": "background/scene-transition", "kind": "background", "family": "bed",
     "title": "Scene transition",
     "purpose": "Ducking that eases out across a scene change instead of jumping.",
     "params": {"trim_db": {"default": 0.0, "min": -6.0, "max": 0.0, "units": "dB"},
                "duck_db": {"default": -5.0, "min": -12.0, "max": 0.0, "units": "dB"},
                "attack_ms": {"default": 120, "min": 40, "max": 400, "units": "ms"},
                "release_ms": {"default": 500, "min": 150, "max": 2000, "units": "ms"},
                "hold_ms": {"default": 250, "min": 0, "max": 1000, "units": "ms"},
                "transition_ms": {"default": 1500, "min": 300, "max": 4000, "units": "ms"}}},
    {"id": "preset/natural-dialogue", "kind": "preset", "family": "preset",
     "title": "Natural dialogue",
     "purpose": "Keep the take as generated; let the bed step back gently.",
     "voice": "voice/preserve", "background": "background/gentle-ducking",
     "treatments": ["dry", "room", "distant"]},
    {"id": "preset/action-scene", "kind": "preset", "family": "preset", "title": "Action scene",
     "purpose": "Shouted lines over a busy bed that keeps its impacts.",
     "voice": "voice/sustained-emphasis", "background": "background/transient-protection",
     "treatments": ["dry", "distant", "radio"]},
    {"id": "preset/quiet-confession", "kind": "preset", "family": "preset",
     "title": "Quiet confession",
     "purpose": "A trailing, intimate line; music makes room and waits through pauses.",
     "voice": "voice/trailing-finish", "background": "background/pause-aware-recovery",
     "treatments": ["dry", "room"]}
  ]
}
