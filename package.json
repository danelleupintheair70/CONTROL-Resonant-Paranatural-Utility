{
  "name": "doblarr-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:ui": "vite --config ui/vite.config.js",
    "build:ui": "vite build --config ui/vite.config.js",
    "lint": "eslint ui tests/frontend playwright.config.js",
    "test": "node --test tests/frontend/*.test.js",
    "test:browser": "npm run build:ui && playwright test",
    "check": "npm run lint && npm test && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4"
  }
}
